text = "Skin"

[node name="Skin" type="Label" parent="Layout/SkinRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Default"

[node name="SkillRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2

