[node name="AddSkill" type="Button" parent="Layout/SkillRow"]
layout_mode = 2
text = "Add"

[node name="PriorityTitle" type="Label" parent="Layout"]
layout_mode = 2
text = "Cast order"

[node name="PriorityList" type="VBoxContainer" parent="Layout"]
layout_mode = 2

[node name="PriorityControls" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Up" type="Button" parent="Layout/PriorityControls"]
layout_mode = 2
