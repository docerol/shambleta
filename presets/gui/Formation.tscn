[gd_scene format=3]

[ext_resource type="Theme" path="res://data/themes/DefaultTheme.tres" id="1"]
[ext_resource type="Script" path="res://sources/gui/Formation.gd" id="2"]
[ext_resource type="PackedScene" path="res://presets/gui/TitleBar.tscn" id="3"]

[node name="Formation" type="PanelContainer"]
custom_minimum_size = Vector2(320, 430)
offset_right = 320.0
offset_bottom = 430.0
theme = ExtResource("1")
theme_type_variation = &"WindowPanel"
script = ExtResource("2")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="TitleBar" parent="Layout" instance=ExtResource("3")]
layout_mode = 2
size_flags_vertical = 0
titleText = "Formation"

[node name="SlotRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="SlotLabel" type="Label" parent="Layout/SlotRow"]
