[gd_scene format=3]

[ext_resource type="Theme" path="res://data/themes/DefaultTheme.tres" id="1"]
[ext_resource type="Script" path="res://sources/gui/SeasonPass.gd" id="2"]
[ext_resource type="PackedScene" path="res://presets/gui/TitleBar.tscn" id="3"]

[node name="SeasonPass" type="PanelContainer"]
custom_minimum_size = Vector2(380, 480)
offset_right = 380.0
offset_bottom = 480.0
theme = ExtResource("1")
theme_type_variation = &"WindowPanel"
script = ExtResource("2")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="TitleBar" parent="Layout" instance=ExtResource("3")]
layout_mode = 2
size_flags_vertical = 0
titleText = "Season Pass"

[node name="Header" type="Label" parent="Layout"]
layout_mode = 2
text = "Season pass: —"
autowrap_mode = 3

[node name="BuyPass" type="Button" parent="Layout"]
layout_mode = 2
text = "Buy premium — R$ 24,90"

[node name="BuyDeluxe" type="Button" parent="Layout"]
layout_mode = 2
text = "Buy deluxe — R$ 44,90"

[node name="SkipLevel" type="Button" parent="Layout"]
layout_mode = 2
text = "Skip level — 50 gems"

[node name="TrackScroll" type="ScrollContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
size_flags_vertical = 3

[node name="TrackList" type="VBoxContainer" parent="Layout/TrackScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MissionScroll" type="ScrollContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 170)
layout_mode = 2
size_flags_vertical = 3

[node name="MissionList" type="VBoxContainer" parent="Layout/MissionScroll"]
layout_mode = 2
size_flags_horizontal = 3

[connection signal="pressed" from="Layout/BuyPass" to="." method="_on_buy_pass_pressed"]
[connection signal="pressed" from="Layout/BuyDeluxe" to="." method="_on_buy_deluxe_pressed"]
[connection signal="pressed" from="Layout/SkipLevel" to="." method="_on_skip_level_pressed"]
