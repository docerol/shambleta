# Shambleta — variáveis de ambiente locais (não versionar este arquivo)
# Copie para .env e ajuste conforme necessário.

# Runtime Godot
SOM_REALTIME_SECS=300
SOM_DIAG_SECS=120
SOM_DIAG_ZONE=1

# Rede
SHAMBLETA_PROXY_TLS=1
SHAMBLETA_SERVER_ADDRESS=ws.seudominio.com
SHAMBLETA_SERVER_PORT=0

# Sessão de "lembrar-me" (game server). O server emite um token de 128-bit e
# grava no DB o HMAC-SHA256 assinado com ESTA chave (Hasher.TokenHmacKeyEnv);
# o companion confere o mesmo HMAC na hora do checkout (companion/server.py,
# verify_session_token). Vazio por regra do gate de segredos (o nome contém
# TOKEN): gere com `openssl rand -hex 32` e ponha no secret do deploy — o MESMO
# valor para o serviço `game` e para o `companion` (chaves diferentes = checkout
# 401 em todo cliente). Sem a env, o container de produção falha fechado: nenhum
# token é emitido nem validado e o login por senha continua funcionando — a
# chave default que vive no fonte é pública e não assina sessão fora de
# dev/editor/testes (P0-4 da auditoria de 2026-10-04).
SHAMBLETA_TOKEN_SIGNING_KEY=

# God Mode (dev/staging SÓ). `sources/debug/CommandManager.gd` derruba com esta env a
# checagem de permissão de todo comando — `/setstat gp`, `/ban`, `/permission` passam
# a valer para QUALQUER conta logada. NUNCA em produção: nem compose, nem Dockerfile,
# nem job de CI, nem painel do Coolify. A régua é de máquina, não de confiança:
# `tests/admission_gate_test.gd` varre `deploy/**` e `.github/**` e reprova se o nome
# aparecer lá (e exige que ele continue existindo AQUI, com este motivo escrito).
# Vazio = desligado; o único valor que liga é `1`.
SHAMBLETA_GM_MODE=

# Fronteira do dinheiro (companion). No browser nada disso é lido: a base do
# companion é a origem da página, porque o nginx do serviço `web` faz proxy de
# /checkout/ e /webhooks/payments. SHAMBLETA_COMPANION_URL só interessa em
# desktop/dev, onde não há proxy na frente.
SHAMBLETA_WEBHOOK_PROVIDER=mercadopago
SHAMBLETA_MP_WEBHOOK_SECRET=
SHAMBLETA_MP_ACCESS_TOKEN=
SHAMBLETA_MP_BACK_URLS_BASE=https://seudominio.com
SHAMBLETA_COMPANION_URL=http://127.0.0.1:8901
# SSV de anúncio recompensado (companion/ad_ssv.py, rota POST /webhooks/ads): o
# segredo compartilhado com o portal, que assina `X-Ad-Signature` sobre
# "<ts>.<corpo>". Vazio por regra da seção 3 deste gate (o nome contém SECRET) — o
# valor é secret da plataforma no deploy. Sem ele a rota responde 503 e nenhum
# anúncio credita: fail-closed, igual às chaves de pagamento acima.
SHAMBLETA_AD_SSV_SECRET=

# Web push (RFC 8292). As duas chaves de credencial ficam vazias por regra do gate
# de segredos (seção 3 de scripts/check_secrets.sh): o template documenta a porta,
# nunca o valor. A privada é um par P-256; gere com
# `python3 companion/server.py --push-vapid-keygen --push-vapid-key-out ARQUIVO`
# (0600, nunca stdout/log) e cole no secret do deploy. Todo nome abaixo é um nome
# que companion/push_common.py lê por `os.environ`, e cada um precisa continuar
# declarado aqui — o gate de segredos confere os dois sentidos: `name_const_hit`
# exige o literal declarado para escusar a constante de NOME, e a regra
# "nenhum *_ENV órfão" pega nome novo que ninguém declarou no template.
SHAMBLETA_VAPID_PRIVATE_KEY=
SHAMBLETA_VAPID_PUBLIC_KEY=
SHAMBLETA_VAPID_SUBJECT=
SHAMBLETA_PUSH_ADMIN_TOKEN=
SHAMBLETA_PUSH_SENDER=vapid
SHAMBLETA_PUSH_TTL=3600
SHAMBLETA_PUSH_TIMEOUT=10
# Vazio de propósito: o nome contém TOKEN, então a seção 3 proíbe valor no
# template. O padrão real (7200 s) mora em companion/push_vapid.py —
# `os.environ.get(VAPID_TOKEN_TTL_ENV) or TOKEN_TTL`.
SHAMBLETA_VAPID_TOKEN_TTL=

# Presença durável (migration 057, implementada em
# sources/network/server/Presence.gd e medida por tests/presence_fuzz.gd). Os dois
# valores ficam vazios de propósito: o padrão mora no fonte, não no template —
# `SHAMBLETA_SERVER_ID` cai em "default" e precisa continuar UM id por processo
# escritor, porque `Presence.ReclaimServer` apaga no boot a cauda do próprio id (dois
# processos dividindo id apagam a presença um do outro);
# `SHAMBLETA_PRESENCE_HEARTBEAT_SEC` cai em 60 s e o TTL é 3 batidas.
SHAMBLETA_SERVER_ID=
SHAMBLETA_PRESENCE_HEARTBEAT_SEC=

# ----------------------------------------------------------------- observação/pager
# Para onde o `severity: page` de deploy/alerts.rules.yml vai. O Alertmanager não
# interpola env no config dele, então estes dois nomes são lidos pelo render do
# entrypoint da imagem (deploy/monitoring/render-alertmanager-config.sh) e
# materializados em deploy/alertmanager.yml no boot do container.
#
# Ficam vazios aqui por dois motivos, e os dois são regra, não descuido: (1) a URL
# de webhook de Slack/PagerDuty/on-call É uma credencial — quem a tem publica no
# canal de emergência — e este repositório é open source; (2) o gate de segredos
# exige valor vazio em campo de credencial no template. O nome é o documento; o
# valor é secret da plataforma no deploy.
#
# Com os dois vazios o stack sobe e o alerta não acorda ninguém: configuração
# incompleta, não segura. `scripts/check_compose.sh` chama isso pelo nome em toda
# execução (escolha (b) de deploy/OPS_RUNBOOK.md §2.1 — a régua acusa, o `up` não
# recusa).
SHAMBLETA_ALERT_PAGE_WEBHOOK_URL=
SHAMBLETA_ALERT_TICKET_WEBHOOK_URL=

# Nomes que deploy/docker-compose.yml e deploy/docker-compose.staging.yml já
# interpolavam sem nunca ter aparecido neste template (a régua de
# `scripts/check_compose.sh` agora pega o buraco): declarar aqui não é cosmético —
# é o que faz um deploy novo saber que precisa preencher, em vez de subir mudo.
# Os quatro são credenciais, então continuam vazios pela mesma regra acima.
SHAMBLETA_STRIPE_WEBHOOK_SECRET=
SHAMBLETA_WEBHOOK_SECRET=
CLOUDFLARED_TOKEN=
STAGING_WEBHOOK_SECRET=
